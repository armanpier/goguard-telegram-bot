# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get your bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram User IDs with admin access (supports [123, 456] or 123,456)
ADMIN_IDS=[123456789, 987654321]

# Support Telegram Username (e.g., @MySupportUser)
SUPPORT_USERNAME=@vpn_support

# Optional: Channel username/ID for mandatory membership before using bot (e.g., @myvpnchannel)
REQUIRED_CHANNEL_ID=

# ==========================================
# GoGuard Panel API 1.0 Configuration
# ==========================================
# Base URL of your GoGuard Panel (without trailing slash)
GOGUARD_BASE_URL=https://core.erfjab.com

# GoGuard Admin Credentials for POST /api/admins/token
GOGUARD_USERNAME=admin
GOGUARD_PASSWORD=supersecretpassword

# Subscription URL Template
# If GoGuard API response contains subscription_url, it is used automatically.
# Otherwise, {base_url} and {username} placeholders will be substituted.
GOGUARD_SUB_URL_TEMPLATE={base_url}/sub/{username}

# API Timeout in seconds
GOGUARD_TIMEOUT_SECONDS=15

# ==========================================
# Database Configuration
# ==========================================
# SQLite (default, zero configuration)
DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db
# PostgreSQL (production alternative)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/goguard_bot

# ==========================================
# Web Management Panel (FastAPI WebUI)
# ==========================================
WEB_ENABLE=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERNAME=admin
WEB_PASSWORD=admin123
WEB_SECRET_KEY=generate_a_random_32_byte_hex_secret_here

# ==========================================
# Payment (Card-to-Card) Configuration
# ==========================================
CARD_NUMBER=6037-9918-0000-0000
CARD_HOLDER=نام دارنده کارت
CURRENCY_TITLE=تومان

# ==========================================
# Free Trial (Test Account) Configuration
# ==========================================
FREE_TRIAL_ENABLED=true
FREE_TRIAL_TRAFFIC_GB=1.0
FREE_TRIAL_DURATION_DAYS=1

# ==========================================
# Referral Program Configuration
# ==========================================
REFERRAL_ENABLED=true
REFERRAL_COMMISSION_PERCENT=10

# ==========================================
# General & Localization
# ==========================================
DEFAULT_LANGUAGE=fa
DEBUG=false
